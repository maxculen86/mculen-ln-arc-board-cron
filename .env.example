# Copiar a .env y ajustar por usuario.

ARC_BOARD_ORG="https://dev.azure.com/lndigital/"
ARC_BOARD_PROJECT="Gestion LANACION-ARC"
ARC_BOARD_AREA_PATH="Gestion LANACION-ARC\\Contenidos-Web-LN"
ARC_BOARD_ASSIGNEE_EMAIL="mculen@lanacion.com.ar"
ARC_BOARD_ASSIGNEE_NAME="mculen"
ARC_REPO_PATH="/home/mculen/Arc"

# Dos veces por día, hora Argentina si tu host está en America/Argentina/Buenos_Aires.
ARC_CRON_SCHEDULE="0 10,17 * * *"
ARC_CRON_DELIVER="local"
ARC_CRON_WORKDIR="/home/mculen"

# Nombre final: azure-devops-board-check-${ARC_BOARD_ASSIGNEE_NAME}
ARC_CRON_NAME_PREFIX="azure-devops-board-check"
