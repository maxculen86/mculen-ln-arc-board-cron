{
    "files.exclude": {
        "_ignore_*": true,
        "_ignore_*.*": true,
        ".scannerwork": true,
        "coverage": true,
        ".tools":true,
        ".dockerignore":true,
        "package-lock.json":true
    },
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always"
    },
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "/data/db/**":true,
        "/data/dumps/**":true,
        "/data/restore/**":true,
        "/coverage/**":true,
        "/.scannerwork/**":true,
        "/dist/**":true,
        "/resources/dist/**":true
    },
    "sonarlint.connectedMode.project": {
        "connectionId": "https-sonar-lanacion-com-ar",
        "projectKey": "arc-ln"
    },
}