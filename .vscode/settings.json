{
    "files.exclude": {
        "_ignore_*": true,
        "_ignore_*.*": true,
        ".huskyrc": true,
        ".prettierrc": true,
        ".scannerwork": true,
        ".lintstagedrc": true,
        ".prettierignore": true,
        ".eslintrc*": true,
        "coverage": true,
        "dist":true,
        ".dockerignore":true,
        ".eslintignore":true,
        "package-lock.json":true
    },
    "editor.tabSize": 4,
    "editor.formatOnSave": false,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "/data/db/**":true,
        "/data/dumps/**":true,
        "/data/restore/**":true,
        "/coverage/**":true,
        "/.scannerwork/**":true,
        "/dist/**":true,
        "/resources/dist/**":true
    }
}