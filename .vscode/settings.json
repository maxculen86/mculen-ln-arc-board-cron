{
    "files.exclude": {
        "_ignore_*.*": true,
        ".fusion": true,
        ".vscode": true,
        ".huskyrc": true,
        ".prettierrc": true,
        ".scannerwork": true,
        ".lintstagedrc": true,
        ".prettierignore": true,
        ".eslintrc*": true,
        "coverage": true,
        "node_modules": true
    },
    "editor.tabSize": 4,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "/data/db/**":true,
        "/data/dumps/**":true,
        "/data/restore/**":true,
        "/coverage/**":true,
        "/.scannerwork/**":true,
        "/dist/**":true,
        "/resources/dist/**":true
    }
}