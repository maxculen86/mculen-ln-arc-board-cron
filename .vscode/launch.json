    "version": "0.2.0",
    "configurations": [

        {
            "name": "Fusion Engine",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "0.0.0.0",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack://Fusion.components/./bundle/src/*": "${workspaceRoot}/*",
                "webpack:///./bundle/src/*": "${workspaceRoot}/*",
                "webpack-internal://Fusion.components/./bundle/src/*": "${workspaceRoot}/*",
                "webpack-internal:///./bundle/src/*": "${workspaceRoot}/*"
            }
        }
    ]
}