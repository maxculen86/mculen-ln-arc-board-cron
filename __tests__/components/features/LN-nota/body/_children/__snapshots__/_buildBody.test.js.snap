      <h3
        class="com-title --font-primary --m --font-medium"
      >
        Ingredientes
      </h3>
      <div>
        <ul
          class="com-unordered"
        >
          <li
            class="com-item"
          >
            Matambrito
          </li>
          <li
            class="com-item"
          >
            Ketchup
          </li>
          <li
            class="com-item"
          >
            Romero
          </li>
