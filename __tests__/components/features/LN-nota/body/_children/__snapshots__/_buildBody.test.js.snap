                300 g
              </td>
            </tr>
            <tr>
              <td>
                Colesterol
              </td>
              <td>
                200 mg
              </td>
            </tr>
            <tr>
              <td>
                Grasas
              </td>
              <td>
                200 g
              </td>
            </tr>
            <tr>
              <td>
                Fibras
              </td>
              <td>
                10 g
              </td>
            </tr>
            <tr>
              <td>
                Proteínas
              </td>
