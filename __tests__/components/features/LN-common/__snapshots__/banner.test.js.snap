exports[`getBannerConfiguration => Deberia traer la configuracion del banner cabezal 1`] = `
<Fragment>
  <DivBannerSSR
    bannerConfiguration={
      Object {
        "bidding": Object {
          "prebid": Object {
            "enabled": true,
          },
        },
        "classes": "--sticky ",
        "device": "desktop",
        "dfpId": 133919216,
        "dimensions": Array [
          Array [
            1,
            1,
          ],
          Array [
            728,
            90,
          ],
          Array [
            920,
            100,
          ],
          Array [
            920,
            170,
          ],
          Array [
            970,
            90,
          ],
          Array [
            1260,
            100,
          ],
          Array [
            1260,
            170,
          ],
        ],
        "slotGroup": "nota",
        "slotId": "cabezal_dsk",
        "slotName": "la_nacion_desktop/Nota/cabezal_dsk",
        "targeting": Object {
          "seccion": "nota",
          "sitio": "lanacion",
        },
        "withoutHide": true,
      }
    }
    key="la_nacion_desktop/Nota/cabezal_dsk"
  />
  <script
    dangerouslySetInnerHTML={
      Object {
        "__html": "
                window.addEventListener('DOMContentLoaded', () => {
                    const sidebar = document.querySelector(\\".lay-sidebar\\") || {};
                    const header = document.querySelector(\\"#header\\") || {};                    
                    const cabezal = document.querySelector('.--cabezal_dsk') || {};
                    window.addEventListener('scroll', () => {
                        const { top: topSidebar } = sidebar.getBoundingClientRect();
                        const viewPoint = topSidebar - cabezal.clientHeight - header.clientHeight;
                        if (viewPoint <= 0 && cabezal.classList.contains('--sticky')) {
                            const { top: topCabezal } = cabezal.getBoundingClientRect();
                            cabezal.classList.remove('--sticky');
                            cabezal.style.top = Math.abs(sidebar.offsetTop - cabezal.clientHeight) + 'px';
                            cabezal.style.position = 'relative';
                            cabezal.style.zIndex = '101';
                        } else if (viewPoint > 0 && !cabezal.classList.contains('--sticky')) {
                            cabezal.classList.add('--sticky');
                            cabezal.style.cssText = '';
                        }
                    });
                })
            ",
      }
    }
    type="text/javascript"
  />
</Fragment>
`;
