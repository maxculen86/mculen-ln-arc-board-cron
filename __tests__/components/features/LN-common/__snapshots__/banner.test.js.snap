exports[`getBannerConfiguration => Deberia traer la configuracion del banner cabezal 1`] = `
<Fragment>
  <DivBannerSSR
    bannerConfiguration={
      Object {
        "bidding": Object {
          "prebid": Object {
            "enabled": true,
          },
        },
        "classes": "--sticky ",
        "device": "desktop",
        "dfpId": 133919216,
        "dimensions": Array [
          Array [
            1,
            1,
          ],
          Array [
            728,
            90,
          ],
          Array [
            920,
            100,
          ],
          Array [
            920,
            170,
          ],
          Array [
            970,
            90,
          ],
          Array [
            1260,
            100,
          ],
          Array [
            1260,
            170,
          ],
        ],
        "slotGroup": "nota",
        "slotId": "cabezal_dsk",
        "slotName": "la_nacion_desktop/Nota/cabezal_dsk",
        "targeting": Object {
          "seccion": "nota",
          "sitio": "lanacion",
        },
        "withoutHide": true,
      }
    }
    key="la_nacion_desktop/Nota/cabezal_dsk"
  />
  <script
    dangerouslySetInnerHTML={
      Object {
        "__html": "
                    window.addEventListener('DOMContentLoaded', () => {
                        const banners = Array.from(document.querySelectorAll('.--cabezal_dsk')) || [];
                        const header = document.querySelector(\\"#header\\");
                        const viewportLimit = document.querySelector('.lay-sidebar') || {};
                        const content = document.querySelector('#content') || {};
                        let paddingTop = 0;
                        let oldScrollY = window.scrollY;

                        const handleSticky = (banner = {}) => {
                            const isScrollUp = oldScrollY > window.scrollY
                            const { top: topViewportLimit } = viewportLimit.getBoundingClientRect();
                            const viewPoint = topViewportLimit - banner.clientHeight - (header ? header.clientHeight : 0);

                            if (viewPoint <= 0 && banner.classList.contains('--sticky')) {
                                if  (content instanceof Element){
                                    paddingTop = parseFloat(window.getComputedStyle(content).getPropertyValue('padding-top')) || 0;
                                }
                                banner.classList.remove('--sticky');
                                banner.style.top = Math.abs(viewportLimit.offsetTop - banner.clientHeight - paddingTop) + 'px';
                                banner.style.position = 'relative';
                            } else if (viewPoint > 0 && !banner.classList.contains('--sticky')) {
                                banner.classList.add('--sticky');
                                banner.style.cssText = '';
                            }

                            if (isScrollUp) {
                                banner.classList.remove('--sticky');
                                banner.style.top = '0';
                            }
                        }
                        
                        window.addEventListener('scroll', () => {
                            banners.forEach(handleSticky)
                            oldScrollY = window.scrollY;
                        })
                    })
                ",
      }
    }
    type="text/javascript"
  />
</Fragment>
`;
