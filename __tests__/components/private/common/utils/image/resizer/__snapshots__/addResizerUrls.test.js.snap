              "referent": {
                "id": "COBHULAOEBDDTPVUVRW6IXEPR4",
                "referent_properties": {
                  "caption": "“Mis muebles son mi herencia, e hice la casa alrededor de ellos, teniendo en cuenta sus dimensiones. Pero mi vida es puertas afuera. En la galería, o directamente en el jardín”",
                  "vanity_credits": {
