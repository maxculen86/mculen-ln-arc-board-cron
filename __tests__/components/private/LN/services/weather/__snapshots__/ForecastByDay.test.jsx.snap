exports[`Components - private - services - weather - ForecastByDay => Test when date is tomorrow  1`] = `
<div>
  <div
    class="extend-forecast"
  >
    <h2
      class="com-text --sueca --l"
    >
      Pronóstico del tiempo en
      <strong>
         Mendoza mañana
      </strong>
    </h2>
    <div
      class="content-forecast"
    >
      <div
        class="forecast-card"
      >
        <div
          class="labeled"
        >
          <h4
            class="com-text --font-bold"
          >
            Mañana
          </h4>
          <span
            class="description --font-light --fivexs"
          >
            sun
          </span>
        </div>
        <div
          class="icon-content"
        >
          <i
            class="com-icon icon-sun"
          >
            <svg
              fill="none"
              height="24"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
