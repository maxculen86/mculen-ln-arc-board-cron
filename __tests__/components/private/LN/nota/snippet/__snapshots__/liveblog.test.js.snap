    },
    {
      \\"@type\\": \\"BlogPosting\\",
      \\"headline\\": \\"Nota de prueba Foto al 100\\",
      \\"url\\": \\"https://www.lanacion.com.ar/arquitectura/nota-de-prueba-foto-al-100-nid25062020#parrafo_3\\",
      \\"@id\\": \\"#parrafo_3\\",
      \\"mainEntityOfPage\\": {
        \\"@type\\": \\"WebPage\\"
      },
      \\"datePublished\\": \\"2020-06-25T20:09:38.448Z\\",
      \\"dateModified\\": \\"2020-06-25T20:09:38.448Z\\",
      \\"articleBody\\": \\"En un lugar de la Mancha, de cuyo nombre no quiero acordarme, no ha mucho tiempo que vivía un hidalgo de los de lanza en astillero.\\",
      \\"image\\": {
        \\"@type\\": \\"ImageObject\\",
        \\"url\\": \\"https://arc-static.glanacion.com/resources/images/placeholderLN-600_amp.jpg$LATEST\\"
      },
      \\"author\\": {
        \\"@type\\": \\"PERSON\\",
        \\"name\\": \\"Redacción LA NACION\\"
      },
      \\"publisher\\": {
        \\"name\\": \\"LA NACION\\",
        \\"@type\\": \\"Organization\\"
      }
    },
    {
      \\"@type\\": \\"BlogPosting\\",
      \\"headline\\": \\"Nota de prueba Foto al 100\\",
      \\"url\\": \\"https://www.lanacion.com.ar/arquitectura/nota-de-prueba-foto-al-100-nid25062020#parrafo_4\\",
      \\"@id\\": \\"#parrafo_4\\",
      \\"mainEntityOfPage\\": {
        \\"@type\\": \\"WebPage\\"
      },
      \\"datePublished\\": \\"2020-06-25T19:59:38.448Z\\",
      \\"dateModified\\": \\"2020-06-25T19:59:38.448Z\\",
      \\"articleBody\\": \\"Quieren decir que tenía el sobrenombre de Quijada, o Quesada, que en esto hay alguna diferencia en los autores que deste caso escriben.\\",
      \\"image\\": {
        \\"@type\\": \\"ImageObject\\",
        \\"url\\": \\"https://arc-static.glanacion.com/resources/images/placeholderLN-600_amp.jpg$LATEST\\"
