      }
    },
    {
      \\"@type\\": \\"BlogPosting\\",
      \\"headline\\": \\"Gym 2 ciudad Celeste\\",
      \\"url\\": \\"https://www.lanacion.com.ar/ciencia/paaawer-ap-dos-nid15062022#parrafo_2\\",
      \\"@id\\": \\"#parrafo_2\\",
      \\"mainEntityOfPage\\": {
        \\"@type\\": \\"WebPage\\"
      },
      \\"datePublished\\": \\"2022-06-23T02:49:00.000Z\\",
      \\"dateModified\\": \\"2022-06-23T02:49:00.000Z\\",
      \\"articleBody\\": \\"El Gimnasio Celeste es el segundo de la región de Kanto. Se encuentra en Ciudad Celeste y su líder es Misty, experta en los Pokémon de tipo agua.\\",
