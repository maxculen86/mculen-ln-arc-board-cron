      \\"datePublished\\": \\"2022-06-21T11:46:00.000Z\\",
      \\"dateModified\\": \\"2022-06-21T11:46:00.000Z\\",
      \\"articleBody\\": \\"El gimnasio de Plateada es el primer gimnasio de Kanto. Su tipo dominante es el roca. El líder de gimnasio es Brock. Los entrenadores que lo derrotan reciben la medalla Roca.\\",
      \\"image\\": {
        \\"@type\\": \\"ImageObject\\",
