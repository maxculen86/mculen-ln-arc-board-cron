{
  "name": "@ln/app",
  "version": "0.1.0",
  "description": "Arc+React App - LN - OTT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf resources/dist",
    "build": "webpack --config ./config/webpack.config.js --env.prod",
    "dev": "webpack --watch --config ./config/webpack.config.js --env.dev --progress --debug",
    "fusion": "fusion",
    "start": "npm run clean && npm run build && fusion start",
    "test": "jest --passWithNoTests --coverage",
    "prettier": "prettier --write **/*.{js,jsx}",
    "eslint": "eslint --ext=js,jsx ."
  },
  "dependencies": {
    "@arc-core-components/content-source_content-api-v4": "^2.0.3-beta.2",
    "lodash.get": "^4.4.2",
    "react": "16.6.1",
    "react-dom": "16.6.1"
  },
  "devDependencies": {
    "@arc-fusion/cli": "^0.2.3",
    "@babel/plugin-proposal-class-properties": "^7.4.0",
    "@babel/preset-env": "^7.4.2",
    "@babel/preset-react": "^7.0.0",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^24.5.0",
    "clean-webpack-plugin": "^2.0.2",
    "enzyme": "^3.7.0",
    "enzyme-adapter-react-16": "^1.7.0",
    "eslint": "^5.15.3",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-config-react-app": "^3.0.8",
    "eslint-plugin-flowtype": "^3.4.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "git-branch-is": "^2.1.0",
    "husky": "^1.3.1",
    "jest": "^24.5.0",
    "jest-enzyme": "^6.1.2",
    "lint-staged": "^8.1.5",
    "mini-css-extract-plugin": "^0.6.0",
    "node-sass-glob-importer": "^5.3.1",
    "prettier": "^1.16.4",
    "webpack": "^4.32.0"
  },
  "repository": {
    "type": "git",
    "url": "https://lndigital.visualstudio.com/Gestion%20LANACION-ARC/_git/Arc"
  },
  "keywords": [],
  "author": "La Nacion",
  "license": "UNLICENSED",
  "jest": {
    "verbose": true,
    "testURL": "http://localhost/",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "globals": {
      "NODE_ENV": "test"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "components",
      "mocks",
      "properties"
    ],
    "setupFiles": [
      "./setupTests.js"
    ],
    "testPathIgnorePatterns": [
      "utils"
    ]
  }
}
