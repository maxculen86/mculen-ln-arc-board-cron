{
    "name": "@ln/app",
    "version": "1.0.0-r20191125",
    "description": "Arc+React App - LN - OTT",
    "private": true,
    "main": "index.js",
    "scripts": {
        "dev": "npm run build-dev && npm run start",
        "prod": "npm run build && npm run start",
        "watch": "npm run build-watch & npm run start",
        "build": "npm run clean && npm run webpack",
        "build-dev": "npm run clean && npm run webpack-dev",
        "build-watch": "npm run clean && npm run webpack-watch",
        "clean": "rm -rf resources/dist",
        "eslint": "eslint --ext=js,jsx",
        "prettier": "prettier --write **/*.{js,jsx,scss}",
        "start": "fusion start",
        "webpack": "webpack --config ./config/webpack.config.js --env.prod",
        "webpack-dev": "webpack --config ./config/webpack.config.js --env.dev",
        "webpack-watch": "webpack --config ./config/webpack.config.js --env.dev --watch --verbose",
        "sonar-local": "sonar-scanner -Dsonar.projectKey=arc-ln -Dsonar.sourceEncoding=UTF-8 -Dsonar.host.url=http://localhost:9000 -Dsonar.sources=./ -Dsonar.language=js -Dsonar.exclusions=__tests__/**,__mocks__/**,.fusion,**.test.js,node_modules,resources -Dsonar.tests=./__tests__ -Dsonar.test.inclusions=./__tests__/**/*.test.js -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info",
        "test": "jest --passWithNoTests --coverage",
        "fusion": "fusion",
        "zip": "npm run build && fusion zip",
        "full-reset-all": "fusion clean && npm run clean && rm -rf node_modules/* --verbose && npm i && npm test",
        "doc": "react-doc-generator ./components/ -o ./components.md",
        "test:e2e": "jest --passWithNoTests --config ./e2eTests/config/jest.config.js",
        "test:e2e:sandbox": "TOKEN=$(echo `node ./e2eTests/utils/sandboxGetCredentials.js`) && ARC_ENDPOINT=SANDBOX SANDBOX_TOKEN=$TOKEN jest --passWithNoTests --config ./e2eTests/config/jest.config.js",
        "test:e2e:local": "ARC_ENDPOINT=LOCAL jest --passWithNoTests --config ./e2eTests/config/jest.config.js"
    },
    "dependencies": {
        "crypto": "1.0.1",
        "jsonwebtoken": "8.5.1",
        "lazy-child": "0.3.1",
        "lodash.get": "4.4.2",
        "node-html-parser": "1.2.14",
        "prop-types": "15.7.2",
        "pym.js": "1.3.2",
        "react": "16.12.0",
        "react-dom": "16.12.0",
        "request-promise-native": "1.0.8",
        "thumbor": "0.1.5"
    },
    "devDependencies": {
        "@arc-fusion/cli": "1.1.0",
        "@babel/plugin-proposal-class-properties": "7.7.0",
        "@babel/preset-env": "7.7.1",
        "@babel/preset-react": "7.7.0",
        "@types/jest": "^26.0.14",
        "babel-eslint": "10.0.3",
        "babel-jest": "24.9.0",
        "babel-polyfill": "^6.26.0",
        "check-dependencies": "1.1.0",
        "clean-webpack-plugin": "2.0.2",
        "css-loader": "2.1.1",
        "enzyme": "3.10.0",
        "enzyme-adapter-react-16": "1.14.0",
        "enzyme-to-json": "3.4.0",
        "eslint": "6.7.0",
        "eslint-config-airbnb": "18.0.1",
        "eslint-config-prettier": "6.7.0",
        "eslint-config-react-app": "5.0.2",
        "eslint-plugin-flowtype": "4.4.1",
        "eslint-plugin-import": "2.18.2",
        "eslint-plugin-jsx-a11y": "6.2.3",
        "eslint-plugin-prettier": "3.1.1",
        "eslint-plugin-react": "7.16.0",
        "eslint-plugin-react-hooks": "2.3.0",
        "file-loader": "3.0.1",
        "git-branch-is": "3.1.0",
        "glob": "7.1.6",
        "husky": "3.1.0",
        "jest": "24.9.0",
        "jest-enzyme": "7.1.1",
        "jest-playwright-jsdom": "0.0.4",
        "jest-playwright-preset": "^1.3.1",
        "lint-staged": "9.4.3",
        "mini-css-extract-plugin": "0.8.0",
        "node-fetch": "^2.6.1",
        "node-sass": "4.13.0",
        "node-sass-glob-importer": "5.3.2",
        "playwright": "1.3.0",
        "prettier": "1.19.1",
        "react-doc-generator": "1.2.5",
        "resolve-url-loader": "3.1.1",
        "sass-loader": "7.3.1",
        "webpack": "4.41.2",
        "webpack-cli": "3.3.10"
    },
    "repository": {
        "type": "git",
        "url": "https://lndigital.visualstudio.com/Gestion%20LANACION-ARC/_git/Arc"
    },
    "keywords": [],
    "author": "La Nacion",
    "license": "UNLICENSED",
    "jest": {
        "verbose": true,
        "testURL": "http://localhost/",
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        },
        "globals": {
            "NODE_ENV": "test"
        },
        "moduleFileExtensions": [
            "js",
            "jsx",
            "json"
        ],
        "moduleDirectories": [
            "node_modules",
            "components",
            "mocks",
            "properties"
        ],
        "setupFiles": [
            "./setupTests.js"
        ],
        "testPathIgnorePatterns": [
            "/__tests__/utils",
            "/e2eTests"
        ],
        "snapshotSerializers": [
            "enzyme-to-json/serializer"
        ],
        "moduleNameMapper": {
            "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
            "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
        }
    }
}
