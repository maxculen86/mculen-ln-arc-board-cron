    "main": "index.js",
    "scripts": {
        "ln:home-ln10": "scripts/copyContenidosCommon.sh",
        "ln:home-ln10:cssmin": "npx uglifycss resources/packages/css/homeln10-style.css > resources/packages/css/homeln10-style.min.css",
        "ln:copycss": "copyfiles --up 1 node_modules/@ln/*-ui*/**/*.css resources/packages/css/",
        "ln:buildjs": "scripts/esbuildScripts.sh",
        "dev": "npm run build-dev && npm run start",
        "prod": "npm run build && npm run start",
        "watch": "npm run build-watch & npm run start",
        "build-dev": "npm run ln:home-ln10 && npm run ln:home-ln10:cssmin && npm run clean && npm run webpack-dev && npm run ln:buildjs",
        "build": "npm run clean && npm run ln:home-ln10:cssmin && npm run webpack",
        "build-watch": "npm run ln:home-ln10 && npm run ln:home-ln10:cssmin && npm run clean && npm run webpack-watch",
        "clean": "rm -rf resources/dist",
        "eslint": "eslint --ext=js,jsx",
        "prettier": "prettier --write **/*.{js,jsx,scss}",
        "start": "fusion start",
        "webpack": "webpack --config ./config/webpack.config.js --env.prod",
        "webpack-dev": "webpack --config ./config/webpack.config.js --env.dev",
        "webpack-watch": "webpack --config ./config/webpack.config.js --env.dev --watch --verbose",
        "sonar-local": "sonar-scanner -Dsonar.projectKey=arc-ln -Dsonar.sourceEncoding=UTF-8 -Dsonar.host.url=http://localhost:9000 -Dsonar.sources=./ -Dsonar.language=js -Dsonar.exclusions=__tests__/**,__mocks__/**,.fusion,**.test.js,node_modules,resources -Dsonar.tests=./__tests__ -Dsonar.test.inclusions=./__tests__/**/*.test.js -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info",
        "test": "jest --passWithNoTests --coverage",
        "fusion": "fusion",
        "zip": "npm run build && fusion zip",
        "full-reset-all": "fusion clean && npm run clean && rm -rf node_modules/* --verbose && npm i && npm test",
        "doc": "react-doc-generator ./components/ -o ./components.md",
        "analize": "npx webpack-bundle-analyzer -p 3000 .fusion/dist/stats.json .fusion/dist/components/combinations/",
        "create-demo": "node ./scripts/gitDemoBranch.mjs",
        "postinstall": "npm run ln:copycss"
    },
