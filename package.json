    "jest": {
        "verbose": true,
        "testURL": "http://localhost/",
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        },
        "globals": {
            "NODE_ENV": "test"
        },
        "moduleFileExtensions": [
            "js",
            "jsx",
            "json"
        ],
        "moduleDirectories": [
            "node_modules",
            "components",
            "mocks",
            "properties"
        ],
        "transformIgnorePatterns": [
            "//node_modules/(?!@ln/common-ui-icon/.*)",
            "//node_modules/(?!@ln/common-ui-preheader/.*)",
            "//node_modules/(?!@ln/common-ui-header/.*)",
            "//node_modules/(?!@ln/common-ui-button/.*)",
            "//node_modules/(?!@ln/common-ui-text/.*)",
            "//node_modules/(?!@ln/contenidos-ui-button/.*)",
            "//node_modules/(?!@ln/contenidos-ui-header/.*)",
            "//node_modules/(?!@ln/contenidos-ui-text/.*)",
            "//node_modules/(?!@ln/contenidos-ui-advance/.*)",
            "//node_modules/(?!@ln/contenidos-ui-cajaafondo/.*)"
        ],
        "setupFiles": [
            "./setupTests.js"
        ],
        "testPathIgnorePatterns": [
            "/__tests__/utils",
            "/e2eTests"
        ],
        "snapshotSerializers": [
            "enzyme-to-json/serializer"
        ],
        "moduleNameMapper": {
            "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
            "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
        },
        "watchPathIgnorePatterns": [
            "node_modules",
            "build"
        ]
    }
