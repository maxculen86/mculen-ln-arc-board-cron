{
  "name": "@ln/app",
  "version": "0.1.0",
  "description": "Arc+React App - LN - OTT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "npm run clean && npm run webpack",
    "build-dev": "npm run clean && npm run webpack-watch",
    "clean": "rm -rf resources/dist",
    "eslint": "eslint --ext=js,jsx .",
    "fusion": "fusion",
    "prettier": "prettier --write **/*.{js,jsx}",
    "sonar-local": "sonar-scanner -Dsonar.projectKey=arc-ln -Dsonar.sourceEncoding=UTF-8 -Dsonar.host.url=http://localhost:9000 -Dsonar.sources=./ -Dsonar.language=js -Dsonar.exclusions=__tests__/**,__mocks__/**,.fusion,**.test.js,node_modules -Dsonar.tests=./__tests__ -Dsonar.test.inclusions=./__tests__/**/*.test.js -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info",
    "start": "npm run build && fusion start",
    "start-dev": "npm run build-dev & fusion start",
    "test": "jest --passWithNoTests --coverage",
    "webpack": "webpack --config ./config/webpack.config.js --env.prod",
    "webpack-watch": "webpack --config ./config/webpack.config.js --env.dev --watch --verbose",
    "zip": "npm run build && fusion zip"
  },
  "dependencies": {
    "@arc-core-components/content-source_content-api-v4": "^2.0.4-beta.0",
    "@arc-core-components/feature_ads-arc-ad": "^0.2.8-beta.0",
    "lodash.get": "^4.4.2",
    "react": "16.6.1",
    "react-dom": "16.6.1"
  },
  "devDependencies": {
    "@arc-fusion/cli": "^1.0.3",
    "@babel/plugin-proposal-class-properties": "^7.4.0",
    "@babel/preset-env": "^7.4.2",
    "@babel/preset-react": "^7.0.0",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^24.5.0",
    "clean-webpack-plugin": "^2.0.2",
    "css-loader": "^2.1.1",
    "enzyme": "^3.10.0",
    "enzyme-adapter-react-16": "^1.7.0",
    "enzyme-to-json": "^3.3.5",
    "eslint": "^5.15.3",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-config-react-app": "^3.0.8",
    "eslint-plugin-flowtype": "^3.4.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "file-loader": "^3.0.1",
    "git-branch-is": "^2.1.0",
    "glob": "^7.1.4",
    "husky": "^1.3.1",
    "jest": "^24.5.0",
    "jest-enzyme": "^7.0.2",
    "lint-staged": "^8.1.5",
    "mini-css-extract-plugin": "^0.6.0",
    "node-sass": "^4.12.0",
    "node-sass-glob-importer": "^5.3.1",
    "prettier": "^1.16.4",
    "resolve-url-loader": "^3.1.0",
    "sass-loader": "^7.1.0",
    "webpack": "^4.32.2",
    "webpack-cli": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://lndigital.visualstudio.com/Gestion%20LANACION-ARC/_git/Arc"
  },
  "keywords": [],
  "author": "La Nacion",
  "license": "UNLICENSED",
  "jest": {
    "verbose": true,
    "testURL": "http://localhost/",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "globals": {
      "NODE_ENV": "test"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "components",
      "mocks",
      "properties"
    ],
    "setupFiles": [
      "./setupTests.js"
    ],
    "testPathIgnorePatterns": [
      "/__tests__/utils"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    }
  }
}
