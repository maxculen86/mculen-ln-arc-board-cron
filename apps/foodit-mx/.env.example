# Variables requeridas por scripts/deployer.js (deploy manual) y scripts/mx-routing.js
# (activar/desactivar el MX Router de /recetas) para apps/foodit-mx en Arc XP.
# Copiar a apps/foodit-mx/.env y completar con los valores reales de Developer Center.
# Nunca commitear el .env real.
#
# NOTA: {ENV}_MX_ROUTING_ACCESS_TOKEN es un token DEDICADO con scope MX Management /
# PageBuilder (modifica siteMappings). NO reutilizar el token del deployer, que es
# deployment-only. El endpoint {ENV}_DEPLOYER_ENDPOINT (host de Arc) SÍ es compartido.
# SANDBOX_MX_SLUG / PROD_MX_SLUG lo usa mx-routing.js (dev/staging reusan SANDBOX_MX_SLUG,
# igual que el deployer reusa SANDBOX_MX_ID). Es el slug del MX (ej. "devlab-ln"), distinto
# del id numérico {ENV}_MX_ID del deployer. Ver GET /pagebuilder/mx/ para el slug real.

# --- Development (npm run deploy:dev) ---
# ⚠️ NO agregar DEVELOP_MX_ID ni DEVELOP_MX_SLUG: los scripts no los leen.
#    dev reusa SANDBOX_MX_ID (deployer) y SANDBOX_MX_SLUG (routing).
DEVELOP_DEPLOYER_ENDPOINT=
DEVELOP_DEPLOYER_ACCESS_TOKEN=
DEVELOP_MX_ROUTING_ACCESS_TOKEN=
DEVELOP_DEPLOYER_FUSION_RELEASE=7.0.2

# --- SANDBOX (npm run deploy) ---
SANDBOX_DEPLOYER_ENDPOINT=
SANDBOX_DEPLOYER_ACCESS_TOKEN=
SANDBOX_MX_ROUTING_ACCESS_TOKEN=
SANDBOX_MX_SLUG=
SANDBOX_DEPLOYER_FUSION_RELEASE=7.0.2
SANDBOX_MX_ID=

# --- STAGING (npm run deploy:staging) ---
# ⚠️ NO agregar STAGING_MX_ID ni STAGING_MX_SLUG: los scripts no los leen.
#    staging reusa SANDBOX_MX_ID (deployer) y SANDBOX_MX_SLUG (routing).
STAGING_DEPLOYER_ENDPOINT=
STAGING_DEPLOYER_ACCESS_TOKEN=
STAGING_MX_ROUTING_ACCESS_TOKEN=
STAGING_DEPLOYER_FUSION_RELEASE=7.0.2

# --- PROD (npm run deploy:prod) ---
PROD_DEPLOYER_ENDPOINT=
PROD_DEPLOYER_ACCESS_TOKEN=
PROD_MX_ROUTING_ACCESS_TOKEN=
PROD_MX_SLUG=
PROD_DEPLOYER_FUSION_RELEASE=7.0.2
PROD_MX_ID=

# --- Polling del estado del deploy (opcionales, tienen default en deployer.js) ---
POLLING_DELAY=10000
TIMEOUT=30
