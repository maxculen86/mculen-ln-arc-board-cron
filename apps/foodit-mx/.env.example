# Variables requeridas por scripts/deployer.js (deploy manual de apps/foodit-mx a Arc XP).
# Copiar a apps/foodit-mx/.env y completar con los valores reales de Developer Center
# (Developer Tools -> Deployer). Nunca commitear el .env real.

# --- Development (npm run deploy:dev) ---
DEVELOP_DEPLOYER_ENDPOINT=
DEVELOP_DEPLOYER_ACCESS_TOKEN=
DEVELOP_DEPLOYER_FUSION_RELEASE=7.0.2
DEVELOP_MX_ID=

# --- SANDBOX (npm run deploy) ---
SANDBOX_DEPLOYER_ENDPOINT=
SANDBOX_DEPLOYER_ACCESS_TOKEN=
SANDBOX_DEPLOYER_FUSION_RELEASE=7.0.2
SANDBOX_MX_ID=

# --- STAGING (npm run deploy:staging) ---
STAGING_DEPLOYER_ENDPOINT=
STAGING_DEPLOYER_ACCESS_TOKEN=
STAGING_DEPLOYER_FUSION_RELEASE=7.0.2

# --- PROD (npm run deploy:prod) ---
PROD_DEPLOYER_ENDPOINT=
PROD_DEPLOYER_ACCESS_TOKEN=
PROD_DEPLOYER_FUSION_RELEASE=7.0.2
PROD_MX_ID=

# --- Polling del estado del deploy (opcionales, tienen default en deployer.js) ---
POLLING_DELAY=10000
TIMEOUT=30
