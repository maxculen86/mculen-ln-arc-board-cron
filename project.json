{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "default",
    "projectType": "application",
    "root": ".",
    "sourceRoot": ".",
    "tags": ["type:app", "scope:default"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run build-dev"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run eslint ."
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm test"
            }
        }
    }
}
