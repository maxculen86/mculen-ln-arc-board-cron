        {
            "_id": "TTV24AIVO5CU3JTUJLJKFW5Q4Q",
            "additional_properties": {},
            "embed": {
                "config": {
                    "date": "2023-02-14",
                    "time": "16:35",
                    "title": "Quiénes no pueden comprar dólar ahorro",
                    "typeList": "liveblog"
                }
            },
            "subtype": "custom-liveblog",
            "type": "custom_embed"
        },
        {
            "_id": "5S4JEUGEJFGMJIAEYWJC4ESFFM",
            "additional_properties": {},
            "content": "Si una persona no tiene acceso a la adquisición de dólar ahorro es porque se encuentra dentro de alguno de estos grupos:",
            "type": "text"
        },
        {
            "_id": "GIE5HYO6FFHXFHIYWQGG2ZDLHM",
            "additional_properties": {},
            "items": [
                {
                    "_id": "4DRFKGT5SZHBRHSB5NX27VA3C4",
                    "content": "Los que hayan adquirido <b>dólar “Bolsa”</b> o <b>contado con liquidación</b> en los 90 días anteriores",
                    "type": "text"
                },
                {
                    "_id": "IRWEJLFLTNAQRBQXENSSVRTMJY",
                    "content": "Los argentinos que operaron <b>Cedears</b>, <b>obligaciones negociables</b> o <b>criptomonedas </b>en los 90 días anteriores",
                    "type": "text"
                },
                {
                    "_id": "6IDBFREKCZDAPN2TZHDSKSN7RE",
                    "content": "Beneficiarios de un <b>plan o programa de la Administración Nacional de la Seguridad Social (Anses)</b>, como la Asignación Universal por Hijo (AUH) o la Asignación Universal por Embarazo (AUE)",
                    "type": "text"
                },
                {
                    "_id": "VNNPJZXVRFDOLMFXXVHJVSPN2Y",
                    "content": "Trabajadores en relación de dependencia que hayan recibido parte de su salario a través del programa de <b>Asistencia al Trabajo y la Producción (ATP) </b>o <b>REPRO</b>",
                    "type": "text"
                },
                {
                    "_id": "K2FSI4HIVVAR3JBWOKC4IEDKYA",
                    "content": "Personas sin ingresos declarados o “<b>consistentes</b>”",
                    "type": "text"
                },
                {
                    "_id": "ZU37YYZEGZGKNENM2FM6NRMDBY",
                    "content": "<b>Cotitulares </b>de cuentas bancarias",
                    "type": "text"
                },
                {
                    "_id": "5MROJY4RTJCBTCFN5NIG7BZBEM",
                    "content": "Quienes ya utilizaron la <b>totalidad de su cupo</b> (US$200 mensuales) a través de compras con tarjeta de crédito o débito",
                    "type": "text"
                },
                {
                    "_id": "B3WJGKWBHVHANMALJP7LAHQFUM",
                    "content": "Quienes hayan refinanciado algún saldo de la <b>tarjeta de crédito</b> a 12 meses",
                    "type": "text"
                },
                {
                    "_id": "2K3VF7H5JVFI7MYIMP6GPBGWHM",
                    "content": "<b>Monotributistas </b>que hayan tramitado los <b>créditos a tasa cero</b>",
                    "type": "text"
                },
                {
                    "_id": "6DRKGQZHPJESLIV3MOSK7435BQ",
                    "content": "Los <b>titulares de créditos UVA</b> que accedieron al <b>congelamiento </b>de las cuotas durante la pandemia",
                    "type": "text"
                },
                {
                    "_id": "LOG5VWJOIBA6PBUHKXVCKPAAYM",
                    "content": "Dueños de <b>pymes </b>que hayan recibido <b>créditos al 24 por ciento</b>",
                    "type": "text"
                },
                {
                    "_id": "SQYB6P4NERDUPITLDRGUVRGYF4",
                    "content": "Quienes tengan <b>subsidios </b>en las <b>tarifas de luz, agua y gas</b>",
                    "type": "text"
                },
                {
                    "_id": "2WACU5GDCZBJLLJRFT4UIB53GY",
                    "content": "Empresas que liquidaron dólar <b>soja</b>",
                    "type": "text"
                }
            ],
            "list_type": "unordered",
            "type": "list"
        },
