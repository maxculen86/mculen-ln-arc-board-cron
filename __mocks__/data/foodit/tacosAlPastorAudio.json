    {
      "_id": "2CLN7ZLINVDHFANMRI4NMXWQGU",
      "content": "Preparación",
      "level": 2,
      "type": "header"
    },
    {
      "_id": "GHDAPMZZZRFUTGLILSBGZHUHGI",
      "content": "Para la Carne",
      "level": 4,
      "type": "header"
    },
    {
      "_id": "6NPXN2IYZJBEXPDK63P2CSVMOY",
      "items": [
        {"content": "Limpiar y cortar la pierna de cerdo en cortes delgados", "type": "text"},
        {"content": "Hidratar los chiles guajillo y anchos.", "type": "text"},
        {"content": "Preparar la marinada mezclando los chiles, ajo, piña, vinagre, achiote, comino, sal y pimienta.", "type": "text"},
        {"content": "Cubrir la carne con la marinada y refrigerar por 4-6 horas.", "type": "text"}
      ],
      "list_type": "ordered",
      "type": "list"
    },
    {
      "_id": "VR2ZXJUZJVBKXPAKTAK3TU4FD4",
      "content": "Para la Cocción",
      "level": 3,
      "type": "header"
    },
    {
      "_id": "G7Z5F7GV5RDT5IR2X4N227WUY4",
      "items": [
        {"content": "Precalentar el horno a 160°C", "type": "text"},
        {"content": "Colocar la carne marinada en una fuente para horno", "type": "text"},
        {"content": "Cubrir con papel aluminio", "type": "text"},
        {"content": "Hornear por 2 horas hasta que la carne esté muy suave", "type": "text"},
        {"content": "Desmenuzar o cortar en trozos pequeños", "type": "text"}
      ],
      "list_type": "ordered",
      "type": "list"
    }
