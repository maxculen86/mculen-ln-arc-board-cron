                                ],
                                "title": "Horacio Rodríguez Larreta: 'Tenemos la necesidad de que las escuelas sigan abiertas'",
                                "tracks": [
                                    {
                                        "file": "https://cdn.jwplayer.com/strips/2X7rlSxi-120.vtt",
