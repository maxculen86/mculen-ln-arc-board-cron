        {
            "_id": "MKSZVPRGFZAS5GOQNKGLXR7IZA",
            "type": "list",
            "list_type": "unordered",
            "additional_properties": {
                "comments": [],
                "inline_comments": []
            },
            "items": [
                {
                    "type": "text",
                    "content": "El Grand Hotel del Tucumán realiza hasta el domingo próximo una feria de artesanías.",
                    "_id": "UOSKCS7Z4VA3DATLVGYQOBROMU",
                    "additional_properties": {
                        "comments": [],
                        "inline_comments": []
                    },
                    "block_properties": {}
                },
                {
                    "type": "text",
                    "content": "Que permite apreciar las diversas manifestaciones culturales de la comunidad provincial.",
                    "_id": "3EFR4OWUZRBHTCJREIUSZEZISI",
                    "additional_properties": {
                        "comments": [],
                        "inline_comments": []
                    },
                    "block_properties": {}
                },
                {
                    "type": "text",
                    "content": "Se exponen, entre otros, trabajos en vidrio, platería, madera, pocelanas, cueros y papel maché.",
                    "_id": "G4HRXY4TNVFNDFUHW6T4AD2A4Y",
                    "additional_properties": {
                        "comments": [],
                        "inline_comments": []
                    },
                    "block_properties": {}
                }
            ]
        },
