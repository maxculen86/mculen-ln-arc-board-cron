class ArticleFeature2 extends React.Component {
    constructor(props) {
        super(props);
        const {
            id: featureId,
            customFields: { noteId: id, imageId }
        } = props;
        this.props = props;
        this.state = { id, imageId, featureId };
        this.fetch = this.fetch.bind(this);
        this.fetch();
    }

    fetch() {
        const { id } = this.state;

        this.fetchContent({
            articleSourceNota: {
                source: 'articleSourceNota',
                query: { id, published: true },
                transform(data) {
                    // Check if data is being returned
                    if (data && data.Search)
                        return {
                            tipoAcumulado: 4,
                            name: 'author2.byline'
                        };
                    // Otherwise just keep the current list of movies
                    return null;
                }
            }
        });
    }

    render() {
        try {
            const { articleSourceNota } = this.state || {};
            const {
                id: featureId,
                customFields: { noteId: id, imageId }
            } = this.props;
            const error = validateArticleFeature(id, articleSourceNota);
            if (!articleSourceNota) {
                return null;
            }
            const acuData = {
                tipoAcumulado: 4,
                name: 'author2.byline'
            };
            return acuData;
        } catch (err) {
            return { Success: false, Message: err.message };
        }
    }
}
ArticleFeature2.label = 'LN Articulo2';

export default Consumer(ArticleFeature2);
